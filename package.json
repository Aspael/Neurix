{
  "name": "aspael-neurix",
  "version": "0.2.1",
  "description": "LLM token calculator: tokens, cost in USD/BRL, context window, file formats, RAG cost and local VRAM/KV cache — interactive CLI in English and Portuguese",
  "keywords": [
    "llm",
    "tokens",
    "token-counter",
    "tokenizer",
    "cost",
    "pricing",
    "context-window",
    "rag",
    "vram",
    "kv-cache",
    "ollama",
    "llama.cpp",
    "claude",
    "openai",
    "gemini",
    "cli",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "author": "Aspael",
  "license": "MIT",
  "homepage": "https://github.com/Aspael/Neurix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aspael/Neurix.git"
  },
  "bugs": {
    "url": "https://github.com/Aspael/Neurix/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "aspael-neurix": "dist/cli.js",
    "neurix": "dist/cli.js",
    "neurix-mcp": "dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "mcp": "node src/mcp.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.ts && node scripts/banner.ts",
    "prices:build": "node scripts/build-prices.ts",
    "prices:check": "node scripts/build-prices.ts --strict",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24",
    "tsup": "^9.0.0",
    "typescript": "5.9"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "^15.1.0",
    "js-tiktoken": "1.0.21",
    "picocolors": "^1.1.1",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@9.15.9"
}
